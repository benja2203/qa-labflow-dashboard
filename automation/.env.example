# Copiar a .env (nunca commitear .env) y completar credenciales reales
# del entorno de Certificación. Pedirlas al equipo de desarrollo de Smartki.

# URLs base — Certificación (ver Confluence "URL SMARTKI")
SMARTKI_API_BASE_URL=https://api.v3.cert.smartki.org/api
SMARTKI_ACTIVITY_BASE_URL=https://api.activities.cert.smartki.org
SMARTKI_DASH_BASE_URL=https://cert.smartki.org
COOPER_DASH_BASE_URL=https://config.cert.smartki.org

# Credenciales de un usuario de servicio para Certificación.
# TODO: confirmar con el equipo de desarrollo cuál es el flujo de login
# de la API 2.0 (usuario/clave -> token JWT, API key fija, etc.) antes
# de completar esto.
SMARTKI_API_USER=
SMARTKI_API_PASSWORD=
